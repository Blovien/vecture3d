build/

# Out-of-tree CMake build directories, which accumulate one per configuration
# once you keep a release, a debug-with-validation and a samples build side by
# side. Listing them individually meant every new configuration leaked into
# git status until someone noticed.
build-*/

.gradle/
imgui.ini
settings.ini
.vscode/
.vs/
.cap
.DS_Store
CMakeUserPresets.json
.cache/
.idea/
.claude/
.tmp/
.fetchcontent-cache/
*.b3rec
Superluminal/
build/v3-release/

# Generated project reports and screenshots
/docs/research/
/docs/testing/alpha-ci.md
/docs/blockgrid-playground.md
