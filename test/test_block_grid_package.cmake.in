set(test_root "@CMAKE_CURRENT_BINARY_DIR@/v3_block_grid_package")
set(producer_build "${test_root}/producer")
set(install_prefix "${test_root}/install")
set(consumer_build "${test_root}/consumer")
set(build_config "@CMAKE_BUILD_TYPE@")
if(build_config STREQUAL "")
	set(build_config Release)
endif()

function(run_step label)
	execute_process(
		COMMAND ${ARGN}
		RESULT_VARIABLE result
		OUTPUT_VARIABLE output
		ERROR_VARIABLE error
	)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "${label} failed (${result})\n${output}\n${error}")
	endif()
endfunction()

file(REMOVE_RECURSE "${test_root}")

set(producer_configure
	"@CMAKE_COMMAND@" -S "@CMAKE_SOURCE_DIR@" -B "${producer_build}"
	"-DBUILD_SHARED_LIBS=ON"
	"-DBOX3D_UNIT_TESTS=OFF"
	"-DBOX3D_SAMPLES=OFF"
	"-DBOX3D_BENCHMARKS=OFF"
	"-DBOX3D_DOCS=OFF"
	"-DBOX3D_VALIDATE=OFF"
	"-DBOX3D_DOUBLE_PRECISION=@BOX3D_DOUBLE_PRECISION@"
	"-DCMAKE_BUILD_TYPE=${build_config}"
	"-DCMAKE_INSTALL_PREFIX=${install_prefix}"
)
if(NOT "@CMAKE_GENERATOR@" STREQUAL "")
	list(APPEND producer_configure -G "@CMAKE_GENERATOR@")
endif()
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
	list(APPEND producer_configure -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
	list(APPEND producer_configure -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
run_step("shared producer configure" ${producer_configure})
run_step("shared producer install" "@CMAKE_COMMAND@" --build "${producer_build}" --config "${build_config}" --target install)

set(consumer_configure
	"@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/package" -B "${consumer_build}"
	"-DCMAKE_BUILD_TYPE=${build_config}"
	"-DCMAKE_PREFIX_PATH=${install_prefix}"
)
if(NOT "@CMAKE_GENERATOR@" STREQUAL "")
	list(APPEND consumer_configure -G "@CMAKE_GENERATOR@")
endif()
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
	list(APPEND consumer_configure -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
	list(APPEND consumer_configure -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
run_step("installed consumer configure" ${consumer_configure})
run_step("installed consumer build and run" "@CMAKE_COMMAND@" --build "${consumer_build}" --config "${build_config}")
